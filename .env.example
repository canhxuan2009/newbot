CLIENT_ID=YOUR_DISCORD_BOT_CLIENT_ID_HERE

# Cấu hình MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=appName

# Cấu hình Dịch tự động DonutSMP (EN -> VI) bằng Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
TRANSLATE_SOURCE_CHANNEL=CHANNEL_ID_NHAN_THONG_BAO_TIENG_ANH
TRANSLATE_TARGET_CHANNEL=CHANNEL_ID_GUI_BAN_DICH_TIENG_VIET
TRANSLATE_PING_ROLE_ID=ROLE_ID_CAN_PING_KHI_CO_THONG_BAO

# Cấu hình Ngân Hàng & Shop (VietQR)
ESCROW_BANK_ID=BIDV
ESCROW_BANK_ACCOUNT=8829484584
